# YOYO Backend Environment Configuration

# Server
PORT=4000
NODE_ENV=development

# Database & Cache
DATABASE_URL=postgresql://yoyo_user:yoyo_secure_pass@localhost:5432/yoyo_db?schema=public
REDIS_URL=redis://localhost:6379

# JWT & Authentication
JWT_SECRET=super_secret_jwt_key_for_yoyo_platform_replace_in_prod
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_DAYS=7

# Inference Worker Configuration
OLLAMA_WORKER_0_URL=http://localhost:11434
OLLAMA_WORKER_1_URL=http://localhost:11435

# Feature Flags
FEATURE_MOCK_INFERENCE=true
FEATURE_BILLING_ENABLED=false

