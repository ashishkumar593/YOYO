    "@types/jest": "^30.0.0",
    "@types/node": "^22.13.4",
    "@types/passport-jwt": "^4.0.1",
    "jest": "^30.5.2",
    "prisma": "^6.4.1",
    "ts-jest": "^29.4.15",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
