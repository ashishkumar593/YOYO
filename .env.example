# YOYO Cloud AI Platform Environment Configuration

# Service Ports & Host Bindings
PORT=4000
WEB_PORT=3000
NODE_ENV=production

# Public Endpoints
NEXT_PUBLIC_APP_URL=https://yoyo.ai
NEXT_PUBLIC_API_URL=https://api.yoyo.ai

# Database & Cache (PostgreSQL 16 & Redis 7)
DATABASE_URL=postgresql://yoyo_user:yoyo_secure_pass@localhost:5432/yoyo_db?schema=public
REDIS_URL=redis://localhost:6379

# Cryptography & JWT Security
JWT_SECRET=super-secret-jwt-key-replace-in-production-yoyo-platform-2026
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_DAYS=7
COOKIE_SECRET=super-secret-cookie-signing-key

# Remote Cloud GPU Inference Clusters (vLLM / SGLang / Ollama)
VLLM_WORKER_0_URL=http://cloud-gpu-node-01:8000
OLLAMA_WORKER_0_URL=http://cloud-gpu-node-02:11434

# Billing & Payments (Stripe)
STRIPE_SECRET_KEY=sk_test_replace_with_live_stripe_secret
STRIPE_WEBHOOK_SECRET=whsec_replace_with_live_webhook_secret

# Runtime Feature Flags
FEATURE_BILLING_ENABLED=true
FEATURE_MOCK_INFERENCE=false
