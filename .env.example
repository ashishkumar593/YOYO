# YOYO Environment Configuration

# Service Ports
PORT=4000
WEB_PORT=3000

# App URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000

# Database & Cache
DATABASE_URL=postgresql://yoyo_user:yoyo_secure_pass@localhost:5432/yoyo_db?schema=public
REDIS_URL=redis://localhost:6379

# Authentication & Security
JWT_SECRET=super-secret-jwt-key-replace-in-production-yoyo-platform
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_DAYS=7
COOKIE_SECRET=super-secret-cookie-signing-key

# Inference Worker Endpoints
OLLAMA_WORKER_0_URL=http://localhost:11434
OLLAMA_WORKER_1_URL=http://localhost:11435

# Feature Flags
FEATURE_BILLING_ENABLED=false
FEATURE_MOCK_INFERENCE=true

