{
  "openapi": "3.0.3",
  "info": {
    "title": "YOYO AI Model API Platform",
    "description": "Production-grade, self-hosted AI model inference API platform with OpenAI compatibility.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:4000",
      "description": "Local Development Server"
    },
    {
      "url": "https://api.yoyo.ai",
      "description": "Production API Gateway"
    }
  ],
  "components": {
    "securitySchemes": {
      "ApiKeyAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "API Key in format: sk_live_..."
      },
      "JwtAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Access JWT for user and administrative routes"
      }
    },
    "schemas": {
      "ChatMessage": {
        "type": "object",
        "required": ["role", "content"],
        "properties": {
          "role": {
            "type": "string",
            "enum": ["system", "user", "assistant", "tool"]
          },
          "content": { "type": "string" }
        }
      },
      "ChatCompletionRequest": {
        "type": "object",
        "required": ["model", "messages"],
        "properties": {
          "model": { "type": "string", "example": "llama3.3:8b" },
          "messages": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/ChatMessage" }
          },
          "temperature": { "type": "number", "default": 0.7 },
          "top_p": { "type": "number", "default": 0.9 },
          "max_tokens": { "type": "integer", "default": 2048 },
          "stream": { "type": "boolean", "default": false }
        }
      },
      "EmbeddingRequest": {
        "type": "object",
        "required": ["model", "input"],
        "properties": {
          "model": { "type": "string", "example": "nomic-embed-text:latest" },
          "input": {
            "oneOf": [
              { "type": "string" },
              { "type": "array", "items": { "type": "string" } }
            ]
          }
        }
      }
    }
  },
  "paths": {
    "/v1/chat/completions": {
      "post": {
        "summary": "Creates a chat completion (OpenAI compatible)",
        "security": [{ "ApiKeyAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/ChatCompletionRequest" }
            }
          }
        },
        "responses": {
          "200": { "description": "Successful completion or SSE stream" },
          "401": { "description": "Invalid or missing API key" },
          "429": { "description": "Rate limit exceeded" }
        }
      }
    },
    "/v1/embeddings": {
      "post": {
        "summary": "Generates vector embeddings",
        "security": [{ "ApiKeyAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/EmbeddingRequest" }
            }
          }
        },
        "responses": {
          "200": { "description": "List of embedding vectors" }
        }
      }
    },
    "/v1/models": {
      "get": {
        "summary": "Lists all available models in OpenAI format",
        "responses": {
          "200": { "description": "List of active models" }
        }
      }
    },
    "/v1/health": {
      "get": {
        "summary": "Health check probe",
        "responses": {
          "200": { "description": "Service is healthy" }
        }
      }
    },
    "/api/auth/login": {
      "post": {
        "summary": "User sign in",
        "responses": {
          "200": { "description": "Returns access and refresh tokens" }
        }
      }
    },
    "/api/auth/register": {
      "post": {
        "summary": "Create new developer account",
        "responses": {
          "201": { "description": "Account created" }
        }
      }
    },
    "/api/keys": {
      "get": {
        "summary": "List API keys",
        "security": [{ "JwtAuth": [] }],
        "responses": {
          "200": { "description": "Active API keys" }
        }
      },
      "post": {
        "summary": "Generate new secret API key",
        "security": [{ "JwtAuth": [] }],
        "responses": {
          "201": { "description": "Plaintext key returned once" }
        }
      }
    },
    "/api/billing/balance": {
      "get": {
        "summary": "Get prepaid credit balance",
        "security": [{ "JwtAuth": [] }],
        "responses": {
          "200": { "description": "Balance in USD" }
        }
      }
    }
  }
}

